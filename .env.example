# HTTP port of the web interface
PORT=3000

# Interface to bind. Keep 127.0.0.1 unless you really want other machines
# on your network to read from / write to your serial devices.
HOST=127.0.0.1

# Default baud rate (can be changed from the UI)
BAUD_RATE=9600

# SQLite file for production test results
DB_PATH=./data/serial-viewer.db

# Traceability: stored with every test result
STATION_ID=ST-01
FIXTURE_ID=FX-SVB100-01
CALIBRATION_ID=CAL-2026-014
# YYYY-MM-DD. After this date real-hardware tests are refused until it is updated.
CALIBRATION_DUE=2027-04-30
# Commit of the deployed build (set by your deploy script; optional)
BUILD_SHA=

# docker compose only: the container runs as this user so ./data stays writable
UID=1000
GID=1000
