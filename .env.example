# HTTP port of the web interface
PORT=3000

# Interface to bind. Keep 127.0.0.1 unless you really want other machines
# on your network to read from / write to your serial devices.
HOST=127.0.0.1

# Default baud rate (can be changed from the UI)
BAUD_RATE=9600

# SQLite file for production test results
DB_PATH=./data/serial-viewer.db
