{
  "name": "pcba-test-station",
  "version": "2.0.0",
  "description": "Web-based functional test station for assembled PCBs: serial numbers, test recipes, PASS/FAIL, traceability and quality reports. Runs in the browser (Web Serial) or with a Node.js server.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "lint": "eslint .",
    "vendor": "node scripts/vendor.js",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "pcba",
    "test-station",
    "functional-test",
    "end-of-line-test",
    "manufacturing",
    "traceability",
    "web-serial",
    "serialport",
    "embedded"
  ],
  "author": "Taha Şahin (https://github.com/sahintaha)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sahintaha/pcba-test-station.git"
  },
  "homepage": "https://sahintaha.github.io/pcba-test-station/",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^4.21.2",
    "serialport": "^12.0.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@playwright/test": "^1.56.1",
    "chart.js": "^4.4.7",
    "eslint": "^9.17.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "^15.14.0",
    "nodemon": "^3.1.9",
    "socket.io-client": "^4.8.4",
    "sortablejs": "^1.15.6"
  }
}
