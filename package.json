{
  "name": "serial-web-viewer",
  "version": "2.0.0",
  "description": "Real-time serial port monitor for Arduino and embedded devices — runs in the browser (Web Serial API) or with a Node.js bridge",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "lint": "eslint .",
    "vendor": "node scripts/vendor.js",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "arduino",
    "serial",
    "serialport",
    "web-serial",
    "iot",
    "embedded",
    "dashboard",
    "socket.io"
  ],
  "author": "Taha Şahin (https://github.com/sahintaha)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sahintaha/serial-web-viewer.git"
  },
  "homepage": "https://sahintaha.github.io/serial-web-viewer/",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^4.21.2",
    "serialport": "^12.0.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@playwright/test": "^1.56.1",
    "chart.js": "^4.4.7",
    "eslint": "^9.17.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "^15.14.0",
    "nodemon": "^3.1.9",
    "socket.io-client": "^4.8.4",
    "sortablejs": "^1.15.6"
  }
}
